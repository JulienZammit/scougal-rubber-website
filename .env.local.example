# Copy this file to .env.local and fill in your values.

# ─── SMTP (employment application emails) ────────────────────────────────────
# SMTP Server Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=smtp.your-provider.com
# 587 for TLS, 465 for SSL, 25 for unencrypted
SMTP_PORT=587
# true for port 465, false for port 587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@scougalrubber.com

# ─── Blog editor (/blog-management) ──────────────────────────────────────────
# Shared login for the internal blog editor.
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign the session cookie. Generate with: openssl rand -hex 32
BLOG_SESSION_SECRET=generate-a-long-random-string

# GitHub publishing (PRODUCTION only).
# If GITHUB_TOKEN is UNSET, the editor runs in LOCAL mode and writes .md files +
# images directly to the repo on disk (great for local testing — leave it unset).
# If SET, "Publish" creates a single commit (article + images) on the branch,
# which the CI/CD pipeline auto-deploys (~1–2 min to go live).
# Use a fine-grained PAT scoped to THIS repo with "Contents: Read and write".
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_OWNER=JulienZammit
# GITHUB_REPO=scougal-rubber-website
# GITHUB_BRANCH=main

# ─── URLs ────────────────────────────────────────────────────────────────────
# Base URL for sitemap/robots
NEXT_PUBLIC_APP_URL=https://www.scougalrubber.com
# Base URL for blog post canonicals (defaults to https://www.scougalrubber.com)
NEXT_PUBLIC_BASE_URL=https://www.scougalrubber.com
